# Copy this file to `.env` in the repo root and fill in real values.
# `.env` is gitignored - never commit it.

# --- Required: Cloudflare Access JWT verification (src/server.js) ---
# The server refuses to start unless both are set. The Access team domain
# (e.g. "yourteam.cloudflareaccess.com") supplies the issuer and the JWKS
# used to verify the `Cf-Access-Jwt-Assertion` header on every request and
# WebSocket upgrade.
ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
# The AUD tag of the Cloudflare Access application protecting this app.
ACCESS_AUD=<your-access-application-aud-tag>

# --- Optional: server (defaults shown) ---
# Directory a terminal opens in when a tile's configured path doesn't exist
# (or isn't a directory). Leave unset to let node-pty fall back to the
# server process's own working directory in that case.
FALLBACK_DIR=
# TCP port to listen on.
PORT=7900
# Address to bind to.
BIND=0.0.0.0
# Minutes of inactivity before a session gets an idle warning, then is killed.
SESSION_IDLE_MINUTES=15
# Minutes a disconnected session is kept alive (for reattachment) before being killed.
SESSION_GRACE_MINUTES=10
# Max bytes of terminal output buffered per session, for replay on reattach.
SESSION_BUFFER_BYTES=262144
# Days of audit logs to keep; older audit-YYYY-MM-DD.log files are pruned at startup.
AUDIT_RETENTION_DAYS=30

# --- Optional: only needed to run `npm run wire` (scripts/wire-cloudflare.js) ---
# Cloudflare account ID.
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
# Cloudflare API token with permission to edit the tunnel config, DNS, and Access apps.
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>
